# Application
APP_NAME=Crypto AI
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://gorm:gorm@localhost:5433/crypto_ai
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# API
API_V1_PREFIX=/api/v1

# Live trading — Binance Spot TESTNET by default (keys: https://testnet.binance.vision).
# A run picks its venue when it starts (Strategies -> Execute -> Target) and is
# frozen to it for life, so the two venues are configured separately. Testnet and
# production are different accounts: a testnet key is rejected by api.binance.com
# and vice versa. Leaving the LIVE pair empty is what keeps "Binance Live"
# unavailable in the UI - fill it in only when you mean to trade real money.
# Testnet keys: https://testnet.binance.vision
# Production keys: Binance -> Account -> API Management. Never enable withdrawals.
BINANCE_TRADE_TESTNET_API_KEY=
BINANCE_TRADE_TESTNET_API_SECRET=
BINANCE_TRADE_LIVE_API_KEY=
BINANCE_TRADE_LIVE_API_SECRET=

# Legacy single-venue settings, still honoured: they supply whichever venue
# BINANCE_TRADE_REST_BASE points at, and are only used when that venue has no
# explicit pair above.
BINANCE_TRADE_REST_BASE=https://testnet.binance.vision
BINANCE_TRADE_API_KEY=
BINANCE_TRADE_API_SECRET=
