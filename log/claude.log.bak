or\",\"statusRunning\":\"Running\",\"statusPending\":\"Pending\",\"deleteTitle\":\"Delete fine-tune records\",\"deleteDescription\":\"This will remove the selected fine-tune tracking records. The model weights are not affected.\",\"deleteConfirm\":\"I understand this action cannot be undone\",\"deleteButton\":\"Delete\",\"deleteInputPlaceholder\":\"Type delete to confirm\",\"toastDeleted\":\"Fine-tune records deleted\",\"toastDeleteError\":\"Failed to delete fine-tune records\",\"selectAll\":\"All\",\"selectStarred\":\"Starred\",\"showOnlySelected\":\"Show selected\",\"showAll\":\"Show all\",\"showing\":\"Showing {from}–{to} of {total}\",\"selectedCount\":\"{selected} of {total} selected\"},\"salesAnalysis\":{\"outletGroup\":\"Outlet Group\",\"allOutlets\":\"All Outlets\",\"period\":\"Weeks\",\"dateRange\":\"Date Range\",\"dateRangePlaceholder\":\"Select date range...\",\"loading\":\"Loading analysis...\",\"noData\":\"No data available for the selected period\",\"outletCount\":\"{count} outlets\",\"tabDataQuality\":\"Data Quality\",\"tabOutliers\":\"Outlier Detection\",\"tabPatterns\":\"Patterns \u0026 Trends\",\"tabDelivery\":\"Delivery Performance\",\"tabSegmentation\":\"Outlet Segmentation\",\"tabHealthCheck\":\"Health Check\",\"summaryMissing\":\"Missing Dates\",\"summaryZeroSales\":\"Zero-Sales Days\",\"summaryDiscrepancies\":\"Discrepancies\",\"summaryLevelShifts\":\"Level Shifts\",\"summaryOutletsWithIssues\":\"Outlets with Issues\",\"missingData\":\"Missing Data Gaps\",\"missingDataDesc\":\"Dates where sales data is expected (outlet open) but missing\",\"zeroSales\":\"Zero-Sales Anomalies\",\"zeroSalesDesc\":\"Days with zero sales on normally open days\",\"fieldDiscrepancies\":\"Field Discrepancies\",\"fieldDiscrepanciesDesc\":\"Persistent differences between sold and scan_sold/net_sold\",\"levelShifts\":\"Level Shifts\",\"levelShiftsDesc\":\"Sudden changes in average sales level\",\"outlet\":\"Outlet\",\"accountId\":\"Account ID\",\"dates\":\"Dates\",\"coun