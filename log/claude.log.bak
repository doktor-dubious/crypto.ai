import asyncio, time

async def test():
    from gorm_ai.database.connection import get_session
    from gorm_ai.services.chat import ChatService, _build_system_prompt, DEFAULT_INSIGHTS_PROMPT
    from gorm_ai.services.chat_tools import TOOL_DEFINITIONS
    from gorm_ai.config import get_settings
    import anthropic
    
    settings = get_settings()
    
    async for session in get_session():
        svc = ChatService(session, settings.claude_api)
        
        # Step 1: Load context  
        customer = await svc._get_customer('5cfcdd74-e243-44a9-8802-ce423a5123ce')
        print(f'1. Customer: {customer.name}')
        
        groups = await svc._get_outlet_groups('5cfcdd74-e243-44a9-8802-ce423a5123ce')
        print(f'2. Groups: {len(groups)}')
        
        sys_prompt, hidden = await svc._get_insights_prompts('5cfcdd74-e243-44a9-8802-ce423a5123ce')
        print(f'3. System prompt len: {len(sys_prompt) if sys_prompt else 0}, hidden: {len(hidden) if hidden else 0}')
        
        system = _build_system_prompt('5cfcdd74-e243-44a9-8802-ce423a5123ce', customer.name, groups, sys_prompt, hidden)
        print(f'4. Full system prompt: {len(system)} chars')
        print(f'5. Tools: {len(TOOL_DEFINITIONS)}')
        
        # Step 2: Call Claude directly
        t0 = time.time()
        try:
            response = await asyncio.wait_for(
                svc.client.messages.create(
                    model='claude-sonnet-4-20250514',
                    max_tokens=4096,
                    system=system,
                    tools=TOOL_DEFINITIONS,
                    messages=[{'role':'user','content':'hello'}],
                ),
                timeout=30,
            )
            elapsed = time.time() - t0
            print(f'6. Response in {elapsed:.1f}s, stop_reason={response.stop_reason}')
            for block in response.content:
                if block.type == 'text':
                    print(f'   text: {block.text[:100]}')
                elif block.type == 'tool_use':
