eturnSequence\":\"Return Sequence\",\"elementName\":\"Name\",\"elementAddress\":\"Address\",\"elementZip\":\"Zip\",\"elementState\":\"State\",\"elementCountry\":\"Country\",\"noElements\":\"No elements assigned\",\"noElementsHint\":\"Drag elements from the right panel to assign them\",\"toastElementAdded\":\"Element added\",\"toastElementRemoved\":\"Element removed\",\"toastUpdated\":\"Template updated\",\"toastUpdateError\":\"Failed to update template\",\"deleteAction\":\"Delete Template\",\"deleteActionDescription\":\"Permanently remove this template and all its elements.\",\"deleteActionConfirm\":\"Type \\"delete\\" to confirm\",\"deleteActionUnderstood\":\"I understand this action is irreversible\",\"deleteActionButton\":\"Delete Template\"},\"systemLogs\":{\"gorm\":\"Gorm\",\"fastapi\":\"FastAPI\",\"finetuning\":\"Finetuning\",\"celeryWorker\":\"Celery Worker\",\"redis\":\"Redis\",\"database\":\"Database\",\"frontend\":\"Frontend\",\"claude\":\"Claude\",\"llm\":\"LLM\",\"searchPlaceholder\":\"Filter log lines...\",\"noLogs\":\"No log lines found\",\"noLogsHint\":\"There are no log entries matching your criteria\",\"showing\":\"Showing {from}–{to} of {total} lines\",\"lineNumber\":\"Line\",\"autoRefresh\":\"Auto-refresh\",\"refresh\":\"Refresh\",\"loadError\":\"Failed to load logs\"},\"userMenu\":{\"account\":\"Account\",\"theme\":\"Theme\",\"settings\":\"Settings\",\"signOut\":\"Sign out\"},\"aiModels\":{\"newButton\":\"New Model\",\"searchPlaceholder\":\"Search models…\",\"noModels\":\"No models found\",\"noModelsHint\":\"Create your first AI model to get started.\",\"selectAll\":\"Select all\",\"starred\":\"Starred\",\"colName\":\"Name\",\"colDescription\":\"Description\",\"showing\":\"Showing {from}–{to} of {total}\",\"selectedCount\":\"{selected} of {total} selected\",\"tabDetails\":\"Details\",\"tabParameters\":\"Parameters\",\"tabFinetune\":\"Fine-tune\",\"tabAction\":\"Action\",\"finetuneEngine\":\"AI Model\",\"finetuneEnginePlaceholder\":\"Select model...\",\"finetuneStepStart\":\"Start Date\",\"finetuneStepEnd\":\"End Date\",\"finetuneNoDate\":\"No date selected\",\"finetuneCount\":\"{accounts} accounts, {outlets} outlets finetuned\",\"finetuneCountZero\":\"No outlets finetuned yet\",\"finetuneProgress\":\"Progress\",\"finetuneResetButton\":\"Reset\",\"finetuneResetTitle\":\"Reset fine-tuning\",\"finetuneResetDescription\":\"This will permanently delete all fine-tuned model weights and progress records for {name}. The next fine-tune will start from the base model.\",\"finetuneResetUnderstand\":\"I understand this action cannot be undone\",\"finetuneResetTypeToConfirm\":\"Type delete to confirm\",\"finetuneResetConfirm\":\"Reset\",\"toastFinetuneReset\":\"Fine-tuning reset successfully\",\"toastFinetuneResetError\":\"Failed to reset fine-tuning\",\"finetuneStart\":\"Start Finetuning\",\"finetuneStarting\":\"Starting...\",\"finetuneSelectOutlets\":\"Select Outlets\",\"finetuneParameters\":\"Fine-tuning Parameters\",\"finetuneCustomer\":\"Customer\",\"finetuneCustomerPlaceholder\":\"Select customer...\",\"finetuneOutletGroup\":\"Outlet Group\",\"finetuneOutletGroupPlaceholder\":\"All outlets\",\"finetuneDateRange\":\"Date Range\",\"finetuneDateRangePlaceholder\":\"Pick a date range\",\"finetuneContextLength\":\"Context Length\",\"finetuneContextLengthInfo\":\"Number of historical time steps the model can look back on when making a prediction. Longer context captures more seasonal patterns but requires more memory.\",\"finetuneHorizon\":\"Horizon\",\"finetuneHorizonInfo\":\"Number of future time steps the model predicts in a single forward pass. Should match your typical prediction window.\",\"finetuneEpochs\":\"Epochs\",\"finetuneEpochsInfo\":\"Number of complete passes through the training data. More epochs can improve accuracy but risk overfitting on small datasets.\",\"finetuneEarlyStoppingPatience\":\"Early Stopping Patience\",\"finetuneEarlyStoppingPatienceInfo\":\"Stop training an outlet when loss hasn't improved for this many epochs. Set to 0 to disable. A value of 5-10 can save significant time without sacrificing quality.\",\"finetuneLearningRate\":\"Learning Rate\",\"finetuneLearningRateInfo\":\"Step size for gradient updates during training. Lower values train more slowly but produce more stable results. Typical range: 1e-5 to 1e-3.\",\"finetuneBatchSize\":\"Batch Size\",\"finetuneBatchSizeInfo\":\"Number of training samples processed together in each gradient update. Larger batches use more GPU memory but can speed up training.\",\"finetuneSyncParameters\":\"Sync Parameters\",\"finetuneSyncModelPath\":\"Model Destination Directory\",\"finetuneSyncModelPathInfo\":\"Directory where the fine-tuned model checkpoint is saved. Each engine should have its own directory. On RunPod this is typically under /models/.\",\"finetuneSyncModelPathPlaceholder\":\"e.g. models/timesfm_finetuned\",\"finetuneSyncEvery\":\"Sync Every (outlets)\",\"finetuneSyncEveryInfo\":\"After this many outlets have been fine-tuned, sync the checkpoint back to the production server. Lower values are safer but incur more transfer costs.\",\"finetuneSyncTarget\":\"Sync Target\",\"finetuneSyncTargetInfo\":\"rsync destination to copy the checkpoint back to, e.g. user@host:/path/to/models/finetune/engine/. Each engine should have its own target path. Leave empty to disable sync.\",\"finetuneSyncTargetPlaceholder\":\"e.g. rune@server:/path/to/models/finetune/moirai/\",\"finetuneAllowNewCheckpoint\":\"Allow New Checkpoint\",\"finetuneAllowNewCheckpointInfo\":\"When disabled, fine-tuning will only resume from an existing checkpoint. If no checkpoint exists locally and cannot be pulled from the sync target, the job will fail instead of creating a new checkpoint from the base model. This prevents accidental overwrites of a trained model.\",\"finetuneRules\":\"Rules\",\"finetunePathologicalDetection\":\"Pathological outlet detection\",\"finetuneSaneEpochs\":\"Epochs\",\"finetuneSaneEpochsInfo\":\"Number of initial training epochs to evaluate before deciding if an outlet's data is pathological. If the best loss hasn't dropped below the maximum MAE after this many epochs, the outlet is skipped and weights are restored.\",\"finetuneMaxMae\":\"Maximum MAE\",\"finetuneMaxMaeInfo\":\"Maximum acceptable mean absolute error after the evaluation epochs. Outlets that exceed this threshold are considered pathological — their data quality issues would corrupt the shared model weights.\",\"finetuneWorker\":\"Worker\",\"finetuneWorkerAny\":\"Any available\",\"toastFinetuneQueued\":\"Finetuning task queued\",\"toastFinetuneError\":\"Failed to start finetuning\",\"finetuneErrorNoCustomer\":\"Select a customer\",\"finetuneErrorNoDates\":\"Select a date range\",\"paramName\":\"Parameter\",\"paramValue\":\"Value\",\"noParameters\":\"No parameters defined\",\"noParametersHint\":\"Add parameters for this engine.\",\"addParameter\":\"Add Parameter\",\"addParameterTitle\":\"New Parameter\",\"addParameterDescription\":\"Add a parameter name/value pair for this engine.\",\"paramNamePlaceholder\":\"e.g. submodel\",\"paramValuePlaceholder\":\"e.g. chronos-t5-base\",\"fieldParameter\":\"Parameter\",\"fieldParameterPlaceholder\":\"e.g. --model-id\",\"fieldSortOrder\":\"Sort Order\",\"toastParameterCreated\":\"Parameter added\",\"toastParameterCreateError\":\"Failed to add parameter\",\"deleteParamTitle\":\"Delete Parameter\",\"deleteParamDescription\":\"Are you sure you want to delete \\"{name}: {value}\\"? This action cannot be undone.\",\"deleteParamConfirm\":\"Delete\",\"toastParameterDeleted\":\"Parameter deleted\",\"toastParameterDeleteError\":\"Failed to delete parameter\",\"fieldSlug\":\"Slug\",\"fieldSlugPlaceholder\":\"e.g. my-model\",\"fieldName\":\"Name\",\"fieldNamePlaceholder\":\"Model name\",\"fieldDescription\":\"Description\",\"fieldDescriptionPlaceholder\":\"Optional description\",\"fieldNotes\":\"Notes\",\"cancel\":\"Cancel\",\"saveChanges\":\"Save changes\",\"saving\":\"Saving…\",\"