# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Better Auth — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Database (same PostgreSQL as backend — note: no +asyncpg prefix)
DATABASE_URL=postgresql://gorm:gorm@localhost:5433/crypto_ai

# Backend FastAPI URL (server-side only, never sent to browser)
BACKEND_INTERNAL_URL=http://localhost:8000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft/Azure OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=   # leave empty for multi-tenant (common endpoint)

# Logging
LOG_LEVEL=info
